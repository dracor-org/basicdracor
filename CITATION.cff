    given-names: "Ingo"
    orcid: "https://orcid.org/0000-0001-8294-2541"
repository-code: "https://github.com/dracor-org/basicdracor"
url: "https://dracor.org"
license: MIT
keywords:
  - DraCor
  - API
  - BASIC
  - QB64
  - drama corpora
